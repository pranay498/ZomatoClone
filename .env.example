# ─────────────────────────────────────────────────────────────────
# ZomatoClone — Production Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# ── EC2 / Deployment ──────────────────────────────────────────────
EC2_PUBLIC_IP=YOUR_EC2_PUBLIC_IP_OR_DOMAIN   # e.g. 13.234.56.78 or api.yourdomain.com

# ── Shared Secrets ───────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_32chars+
INTERNAL_SERVICE_KEY=change_this_to_another_long_random_secret

# ── RabbitMQ (local container) ────────────────────────────────────
RABBITMQ_USER=admin
RABBITMQ_PASS=change_rabbitmq_password

# ── MongoDB Atlas (one URI per service, can be the same cluster) ──
MONGODB_URI_USER=mongodb+srv://<user>:<pass>@cluster0.xyz.mongodb.net/user_service
MONGODB_URI_RESTAURANT=mongodb+srv://<user>:<pass>@cluster0.xyz.mongodb.net/restaurant_service
MONGODB_URI_PAYMENT=mongodb+srv://<user>:<pass>@cluster0.xyz.mongodb.net/payment_service
MONGODB_URI_RIDER=mongodb+srv://<user>:<pass>@cluster0.xyz.mongodb.net/rider_service
MONGODB_URI_ADMIN=mongodb+srv://<user>:<pass>@cluster0.xyz.mongodb.net/admin_service

# ── Redis (Upstash or self-hosted) ────────────────────────────────
# Use your Upstash TLS URL or: redis://redis:6379 to use the local container
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# ── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID

# ── Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# ── Cloudinary (image uploads) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
